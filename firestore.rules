rules_version = '2';

// Sicherheitsregeln für die Website von Derya Kılıç
// Admin = Derya Hanıms Konto (User UID aus Firebase Authentication).
// (Firebase-Konsole → Authentication → Users → Spalte "User UID").
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Hilfsfunktionen ----------
    function isAdmin() {
      return request.auth != null && request.auth.uid == "2cOJOB2Ojqg6UUtA3bc8IwCnc5r2";
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Neue Terminanfrage: nur erlaubte Felder, Status "pending", sinnvolle Längen
    function validBooking(d) {
      return d.keys().hasOnly(['clientCode', 'name', 'email', 'phone', 'date', 'time', 'service', 'format',
                               'tz', 'startUTC', 'lang', 'isNewClient', 'source', 'anamnese', 'status', 'createdAt'])
        && d.status == 'pending'
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.phone is string && d.phone.size() <= 40
        && d.email is string && d.email.size() <= 120
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && d.time.matches('^[0-9]{2}:[0-9]{2}$')
        && d['service'] is string && d['service'].size() <= 80;
    }

    // Klient/Gast darf seinen Termin NUR absagen (Status -> cancelled), sonst nichts ändern
    function cancelOnly() {
      return onlyChanges(['status', 'cancelledAt', 'lateCancel', 'feeCharged'])
        && request.resource.data.status == 'cancelled'
        && resource.data.status in ['pending', 'approved'];
    }

    // Zahlungsfrist abgelaufen + offener Betrag -> Klient darf nicht buchen
    function isLocked(code) {
      let c = get(/databases/$(database)/documents/clients/$(code)).data;
      return c.get('payDeadlineMs', 0) > 0
        && request.time.toMillis() > c.get('payDeadlineMs', 0)
        && c.get('balance', 0) > 0;
    }

    // Ausfallgebühr bei Absage < 24 h: Klient darf seinen offenen Betrag nur um genau 30 € oder 50 € erhöhen
    function lateFeeOnly() {
      return onlyChanges(['balance', 'payment'])
        && request.resource.data.balance is number
        && (request.resource.data.balance - resource.data.get('balance', 0) == 30
            || request.resource.data.balance - resource.data.get('balance', 0) == 50);
    }

    // ---------- Öffentlicher Kalender: nur Datum/Uhrzeit, keine Personendaten ----------
    match /slots/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /privateSlots/{id} {
      allow read, write: if isAdmin();
    }

    // ---------- Gast-Anfragen (Dokument-ID ist zufällig und geheim) ----------
    match /appointments/{id} {
      allow get: if isAdmin() || resource.data.status in ['pending', 'approved'];
      allow list: if isAdmin();
      allow create: if isAdmin() || (validBooking(request.resource.data) && request.resource.data.clientCode == 'GUEST');
      allow update: if isAdmin() || cancelOnly();
      allow delete: if isAdmin();
    }

    // ---------- Klienten: der Code (Dokument-ID) ist das Passwort ----------
    match /clients/{code} {
      allow get: if true;                       // nur wer den genauen Code kennt
      allow update: if isAdmin() || lateFeeOnly();
      allow list, create, delete: if isAdmin();

      match /appointments/{id} {
        allow read: if true;                    // Pfad enthält den Code
        allow create: if isAdmin() || (validBooking(request.resource.data) && request.resource.data.clientCode == code && !isLocked(code));
        allow update: if isAdmin() || cancelOnly();
        allow delete: if isAdmin();
      }

      match /payments/{id} {
        allow read: if true;
        // Klient darf nur: eine PayPal-Zahlung "zur Prüfung" melden ODER die Ausfallgebühr (30/50 €) bei einer kurzfristigen Absage buchen
        allow create: if isAdmin() || (
             request.resource.data.keys().hasOnly(['type', 'amount', 'method', 'source', 'status', 'paypalOrderId', 'createdAt'])
          && request.resource.data.type == 'payment'
          && request.resource.data.status == 'pending'
          && request.resource.data.amount is number
          && request.resource.data.amount > 0 && request.resource.data.amount < 5000)
          || (request.resource.data.keys().hasOnly(['type', 'amount', 'method', 'source', 'status', 'balanceAfter', 'createdAt'])
          && request.resource.data.type == 'charge'
          && request.resource.data.source == 'late-cancel'
          && request.resource.data.status == 'confirmed'
          && request.resource.data.amount in [30, 50]);
        allow update, delete: if isAdmin();
      }
    }

    // Abfragen über alle Klienten hinweg (Admin-Panel)
    match /{path=**}/appointments/{id} {
      allow read: if isAdmin();
    }
    match /{path=**}/payments/{id} {
      allow read: if isAdmin();
    }

    // ---------- Klienten-Erkennung auf der Buchungsseite: nur Hashwerte, einzeln abrufbar, keine Liste ----------
    match /contactIndex/{h} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // ---------- Private Notizen ----------
    match /adminNotes/{code} {
      allow read, write: if isAdmin();
    }

    // ---------- Bewertungen ----------
    match /comments/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'stars', 'text', 'lang', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() >= 5 && request.resource.data.text.size() <= 800
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
      allow update, delete: if isAdmin();
    }

    // ---------- Alles andere: nur Derya Hanım ----------
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
